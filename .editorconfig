root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.cs]
indent_style = tab
indent_size = 4
max_line_length = 100
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion

[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
